FROM rust:1.89-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock* ./
COPY crates ./crates
COPY apps ./apps
RUN cargo build --release -p swiftrag-api

FROM debian:bookworm-slim
RUN useradd --create-home --uid 10001 swiftrag
WORKDIR /app
COPY --from=build /src/target/release/swiftrag-api /usr/local/bin/swiftrag-api
COPY config ./config
USER swiftrag
EXPOSE 8080
CMD ["/usr/local/bin/swiftrag-api"]
